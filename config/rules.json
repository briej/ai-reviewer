{
  "security": {
    "sql-injection": {
      "pattern": "execute\\(f?['\"].*\\{.*\\}",
      "severity": "critical",
      "message": "SQL Injection via f-string. Use parameterized queries.",
      "example": "cursor.execute('SELECT * FROM users WHERE id = ?', (user_id,))",
      "languages": ["python"]
    },
    "hardcoded-secret": {
      "pattern": "(password|passwd|pwd|secret|api_key|apikey|token)\\s*=\\s*['\"][^'\"]{4,}['\"]",
      "severity": "critical",
      "message": "Hardcoded secret. Use environment variables.",
      "example": "import os\npassword = os.getenv('DB_PASSWORD')",
      "languages": ["python", "javascript"]
    },
    "hardcoded-api-key": {
      "pattern": "(api_key|apikey|api-key|secret)\\s*=\\s*['\"][a-zA-Z0-9]{20,}['\"]",
      "severity": "critical",
      "message": "Hardcoded API key. Use os.getenv() or dotenv.",
      "example": "api_key = os.getenv('API_KEY')",
      "languages": ["python", "javascript"]
    },
    "code-injection": {
      "pattern": "\\b(eval|exec)\\s*\\(",
      "severity": "critical",
      "message": "eval()/exec() are dangerous — possible RCE.",
      "example": "# Use ast.literal_eval for safe evaluation",
      "languages": ["python", "javascript"]
    },
    "insecure-random": {
      "pattern": "random\\.random\\(\\)|random\\.randint\\(",
      "severity": "warning",
      "message": "random is not cryptographically secure. Use secrets.",
      "example": "import secrets\ntoken = secrets.token_hex(32)",
      "languages": ["python"]
    }
  },
  "bugs": {
    "none-comparison": {
      "pattern": "==\\s*None|!=\\s*None",
      "severity": "info",
      "message": "Use 'is None' or 'is not None' instead of '== None'",
      "example": "if value is None:\n    pass",
      "languages": ["python"]
    },
    "bare-except": {
      "pattern": "except\\s*:",
      "severity": "warning",
      "message": "Bare except catches everything — be specific.",
      "example": "except ValueError as e:\n    handle_error(e)",
      "languages": ["python"]
    },
    "mutable-default": {
      "pattern": "def\\s+\\w+\\([^)]*\\[\\]|def\\s+\\w+\\([^)]*\\{\\}",
      "severity": "warning",
      "message": "Mutable default argument — anti-pattern.",
      "example": "def func(items=None):\n    if items is None:\n        items = []",
      "languages": ["python"]
    }
  },
  "smells": {
    "long-function": {
      "type": "metric",
      "metric": "line_count",
      "threshold": 50,
      "severity": "warning",
      "message": "Function too long (>50 lines). Split into smaller ones.",
      "languages": ["python", "javascript"]
    },
    "deep-nesting": {
      "type": "metric",
      "metric": "nesting_depth",
      "threshold": 4,
      "severity": "warning",
      "message": "Too deep nesting (>4 levels). Use early return.",
      "languages": ["python", "javascript"]
    },
    "too-many-args": {
      "type": "metric",
      "metric": "arg_count",
      "threshold": 5,
      "severity": "info",
      "message": "Too many arguments. Use object/dict.",
      "languages": ["python", "javascript"]
    }
  },
  "performance": {
    "string-concat-loop": {
      "pattern": "for\\s+\\w+\\s+in\\s+\\w+:\\s+\\w+\\s*\\+=\\s*['\"]",
      "severity": "info",
      "message": "String concatenation in loop. Use join()",
      "example": "result = ''.join(items)",
      "languages": ["python"]
    },
    "list-in-loop": {
      "pattern": "for\\s+\\w+\\s+in\\s+range\\(len\\(",
      "severity": "info",
      "message": "Use enumerate() instead of range(len())",
      "example": "for i, item in enumerate(items):",
      "languages": ["python"]
    }
  }
}
